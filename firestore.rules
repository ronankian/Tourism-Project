rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for destinations and other content
    match /destinations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Bookings - public access for tourism booking system
    match /bookings/{bookingId} {
      allow read, create: if true; // Allow public access for tourism bookings
      allow update, delete: if true; // Allow updates (admin check done in application)
    }
    
    // Booking settings - admin only
    match /settings/bookingSettings {
      allow read: if true; // Allow public read for booking availability
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Contact information - public read, admin write
    match /settings/contactInfo {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Booking settings - allow read for all, write for authenticated users (admin check done client-side)
    match /booking_settings/{settingsId} {
      allow read: if true; // Allow public read for the booking page to check settings
      allow create, update: if true; // Allow creation and updates (admin check done in application)
      allow delete: if false; // Prevent deletion of settings
    }
    
    // Emails collection for email sending
    match /emails/{emailId} {
      allow read, write: if request.auth != null;
    }
    
    // News posts - public read, admin write (admin check done client-side)
    match /news_posts/{postId} {
      allow read: if true; // Allow public read for news page
      allow create, update, delete: if true; // Allow write operations (admin check done in application)
    }
    
    // Advisories - public read, admin write (admin check done client-side)
    match /advisories/{advisoryId} {
      allow read: if true; // Allow public read for ticker display
      allow create, update, delete: if true; // Allow write operations (admin check done in application)
    }
    
    // System settings - admin only (for password management)
    match /system_settings/{documentId} {
      allow read, write: if true; // Allow access (admin check done in application)
    }
  }
} 