rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reading for password reset email verification (unauthenticated)
      allow read: if true;
    }
    
    // Public read access for destinations and other content
    match /destinations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Bookings
    // - Allow unauthenticated users to create bookings (for testing)
    // - Allow them to read bookings that match their email
    // - Allow public read for duplicate checking
    match /bookings/{bookingId} {
      allow read: if true; // Allow reading for duplicate checks
      allow create: if true; // Allow unauthenticated users to create (temporary for testing)
      allow update, delete: if request.auth != null && (
        resource.data.email == request.auth.token.email ||
        request.auth.token.role == 'admin'
      );
    }
    
    // Verification codes - allow read/write for verification process
    match /verification_codes/{email} {
      allow read, write: if true;
    }
    
    // Reset codes - allow read/write for password reset process
    match /reset_codes/{email} {
      allow read, write: if true;
    }
    
    // Emails collection for email sending
    match /emails/{emailId} {
      allow read, write: if request.auth != null;
    }
  }
} 