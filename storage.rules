rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload permission letters
    match /permission-letters/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // Allow public read access to other files (images, etc.)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
